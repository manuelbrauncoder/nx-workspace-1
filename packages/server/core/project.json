{
  "name": "server-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/server/core/src",
  "tags": ["type:server", "scope:shared"],
  "targets": {
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"],
