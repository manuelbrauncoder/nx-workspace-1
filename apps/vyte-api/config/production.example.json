{
  "port": 3000,
  "logLevel": "info",
  "trustProxy": 1,
  "cors": {
    "origins": ["https://vyte.manuel-braun.net"]
  },
  "session": {
    "cookieName": "__Host-sid",
    "maxAgeDays": 7,
    "secureCookie": true
  },
  "rateLimit": {
    "authWindowMinutes": 15,
    "authMaxRequests": 20,
    "rsvpWindowMinutes": 15,
    "rsvpMaxRequests": 60,
    "uploadWindowMinutes": 15,
    "uploadMaxRequests": 200,
    "previewWindowMinutes": 15,
    "previewMaxRequests": 300
  },
  "auth": {
    "signUpEnabled": false
  },
  "admin": {
    "email": "admin@mail.dev",
    "password": "change-me-before-deploying"
  },
  "docs": {
    "enabled": false
  },
  "uploads": {
    "dir": "./uploads",
    "maxFileSizeMb": 10,
    "maxImageWidth": 2000
  },
  "photos": {
    "maxPerGuest": 6,
    "maxPerDevice": 6,
    "maxPerEvent": 1000,
    "maxPerStand": 500,
    "uploadDaysAfterEnd": 7,
    "maxImageWidth": 2560
  }
}
