# Path to the JSON config file (non-secret settings)
CONFIG_PATH=config/development.json

# Matches docker-compose.yml
DATABASE_URL=postgresql://app:app@localhost:5432/dartomat_api

# Required by the shared config of every API app, although dartomat has no sign-in.
# At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=
