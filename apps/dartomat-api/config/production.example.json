{
  "port": 3000,
  "logLevel": "info",
  "trustProxy": 1,
  "cors": {
    "origins": ["https://dartomat.example.com"]
  },
  "session": {
    "cookieName": "sid",
    "maxAgeDays": 1,
    "secureCookie": true
  },
  "rateLimit": {
    "authWindowMinutes": 15,
    "authMaxRequests": 20,
    "createGameWindowMinutes": 15,
    "createGameMaxRequests": 30
  },
  "admin": {
    "email": "admin@mail.dev",
    "password": "unused-but-required"
  },
  "docs": {
    "enabled": false
  }
}
