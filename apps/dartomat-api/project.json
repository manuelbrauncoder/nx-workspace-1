{
  "name": "dartomat-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dartomat-api/src",
  "tags": ["type:api-app", "scope:dartomat"],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/dist/apps/dartomat-api"]
    },
    "serve": {
      "continuous": true,
      "command": "tsx watch --env-file=.env src/index.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "start": {
      "continuous": true,
      "dependsOn": ["build"],
      "command": "node --env-file-if-exists=.env ../../dist/apps/dartomat-api/index.js",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "tsc -p tsconfig.json"
      }
    },
    "db:generate": {
      "command": "drizzle-kit generate",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "db:migrate": {
      "command": "tsx --env-file=.env src/scripts/migrate.ts",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "db:studio": {
      "continuous": true,
      "command": "node --env-file=.env ../../node_modules/drizzle-kit/bin.cjs studio",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/dartomat-api/package.json",
        "{workspaceRoot}/dist/apps/dartomat-api/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    }
  }
}
