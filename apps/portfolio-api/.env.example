# Path to the JSON config file (non-secret settings)
CONFIG_PATH=config/development.json

# Matches docker-compose.yml
DATABASE_URL=postgresql://app:app@localhost:5432/portfolio_api

# At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Password of the SMTP account in mail.user of the config file. Only needed while mail.enabled is true.
SMTP_PASSWORD=
