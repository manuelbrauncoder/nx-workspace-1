{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@api/*": ["./apps/angular-base/src/api/*"],
      "@core/*": ["./packages/shared/core/src/*"],
      "@features/*": ["./apps/angular-base/src/app/features/*"],
      "@shared/*": ["./packages/shared/ui/src/*"],
      "@spartan-ng/helm/*": ["./packages/shared/helm-vega/*/src/index.ts"],
      "@contracts/*": ["./packages/contracts/src/*"],
      "@server/core/*": ["./packages/server/core/src/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "exclude": ["node_modules", "tmp"]
}
